# Безопасный режим: письма не отправляются, пока не поставить false
DRY_RUN_EMAIL=true

# SMTP для реальной отправки
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bot@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=bot@example.com

# Получатели обращений по увольнению (по одному на каждый сценарий/intent).
# Если переменная не задана, используется адрес из data/faq.json.
RECIPIENT_EMAIL_ADMIN_DISMISSAL=dismissal@exc.ltd
RECIPIENT_EMAIL_VAHTA_DISMISSAL=kadry@exc.ltd

# Параметры web-сервера
HOST=0.0.0.0
PORT=8000
