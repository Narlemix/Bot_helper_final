# Безопасный режим: письма не отправляются, пока не поставить false
DRY_RUN_EMAIL=true

# Логи маршрутизации (какая тема определена, на какой email бы ушло обращение) —
# пишутся в stdout контейнера уровнем INFO по умолчанию, их видно во вкладке
# Logs на Railway или через `docker compose logs -f`, без изменений кода.
# DEBUG добавит больше деталей от сторонних библиотек — обычно не нужно.
LOG_LEVEL=INFO

# Логин/пароль для страницы /admin/logs — живой просмотр тех же логов маршрутизации
# прямо на самом сайте (Basic Auth). Пока не заданы — страница отвечает 503 и недоступна
# никому, это осознанно (не открыта по умолчанию).
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# SMTP для реальной отправки
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bot@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=bot@example.com

# Получатели обращений (по одному на каждый сценарий/intent, ключ из data/faq.json в UPPER_SNAKE_CASE).
# Если переменная не задана, используется адрес из data/faq.json — эти строки нужны только чтобы
# переопределить конкретный адрес без правки JSON (например, в проде завести свой ящик).
RECIPIENT_EMAIL_ADMIN_DISMISSAL=dismissal@exc.ltd
RECIPIENT_EMAIL_VAHTA_DISMISSAL=kadry@exc.ltd
RECIPIENT_EMAIL_VAHTA_HR_OTHER=kadry@exc.ltd
RECIPIENT_EMAIL_VAHTA_TRAVEL_COMPENSATION=proezd@exc.ltd
RECIPIENT_EMAIL_VAHTA_WEEKEND_REGISTRATION=oformlenievixi@exc.ltd
RECIPIENT_EMAIL_ADMIN_CERTIFICATES=zak-spr-zp@exc.ltd
RECIPIENT_EMAIL_ADMIN_ACCOUNTABLE_FUNDS=zap-ds@exc.ltd
RECIPIENT_EMAIL_ADMIN_ORG_STRUCTURE=izm-org-str-pod@exc.ltd
RECIPIENT_EMAIL_ADMIN_NEW_EMPLOYEE=RnE@exc.ltd
RECIPIENT_EMAIL_ADMIN_LAWYERS=lawyers@exc.ltd
RECIPIENT_EMAIL_ADMIN_CLAIMS=claim@exc.ltd
RECIPIENT_EMAIL_ADMIN_CLAIMS_OVER_50K=claimover@exc.ltd
RECIPIENT_EMAIL_ADMIN_CLAIMS_UNDER_50K=claimlower@exc.ltd
RECIPIENT_EMAIL_ADMIN_POWER_OF_ATTORNEY=Coorpao@exc.ltd
RECIPIENT_EMAIL_ADMIN_SUPPLIER_CONTRACT=sogl-dog-post@exc.ltd
RECIPIENT_EMAIL_ADMIN_INVOICE_PAYMENT=sogl-scheta@exc.ltd
RECIPIENT_EMAIL_ADMIN_RECRUITING=hr@exc.ltd

# Параметры web-сервера
HOST=0.0.0.0
PORT=8000
